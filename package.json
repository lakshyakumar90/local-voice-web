{
  "name": "localvoice-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "verify:apk": "node scripts/verify-apk.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write app components lib scripts next.config.ts",
    "format:check": "prettier --check app components lib scripts next.config.ts"
  },
  "dependencies": {
    "gsap": "^3.14.0",
    "lucide-react": "^0.577.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}